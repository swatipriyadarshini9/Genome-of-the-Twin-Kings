extends SceneTree

var failures: Array[String] = []

func _initialize() -> void:
	call_deferred("_run")

func _check(condition: bool, message: String) -> void:
	if not condition:
		failures.append(message)
		push_error("FAIL: " + message)

func _has_label(node: Node, fragment: String) -> bool:
	for child in node.get_children():
		if child is Label and fragment in child.text:
			return true
	return false

func _snapshot_file(path: String) -> Dictionary:
	return {"exists": FileAccess.file_exists(path), "bytes": FileAccess.get_file_as_bytes(path) if FileAccess.file_exists(path) else PackedByteArray()}

func _restore_file(path: String, snapshot: Dictionary) -> void:
	if snapshot["exists"]:
		var file := FileAccess.open(path, FileAccess.WRITE)
		if file != null:
			file.store_buffer(snapshot["bytes"])
			file.close()
	elif FileAccess.file_exists(path):
		DirAccess.remove_absolute(ProjectSettings.globalize_path(path))

func _run() -> void:
	# Keep an existing real save/settings intact when the tests run locally.
	var old_game := _snapshot_file(SaveData.GAME_PATH)
	var old_settings := _snapshot_file(SaveData.SETTINGS_PATH)
	var main = load("res://scenes/main.tscn").instantiate()
	root.add_child(main)
	await process_frame
	var title_label: Label = null
	for child in main.scene_layer.get_children():
		if child is Label and child.text == "GENOME":
			title_label = child
	_check(is_instance_valid(title_label) and title_label.size.y >= main.TITLE_FONT.get_height(67), "title has room to render")
	main.settings = {"reduced_motion": true, "show_hints": true}
	main._begin_new_game()
	_check(main.current_screen == "game" and main.overlay_kind == "intro", "new game enters the prologue")
	main._dismiss_intro()
	_check(SaveData.load_game().get("intro_seen", false), "intro dismissal is saved")

	main.player_x = main.GATE_X
	main._interact()
	_check(main.overlay_kind == "gate_locked" and not main.game["puzzle_solved"], "gate stays locked before the puzzle")
	main._clear_modal()

	main.player_x = 270.0
	main._walk_to_terminal()
	main._process(3.0)
	_check(main.overlay_kind == "puzzle", "walking to terminal opens the puzzle")
	main._on_base_toggled(true, 1)
	main._check_puzzle()
	_check(main.overlay_kind == "puzzle" and not main.game["puzzle_solved"], "incorrect evidence is rejected")
	_check(not main.puzzle_feedback.text.is_empty(), "incorrect answer gives feedback")
	main._reveal_hint()
	_check(main.is_hint_visible and main.puzzle_hint.text.contains("1–9"), "hint is available")
	main._on_base_toggled(false, 1)
	main._on_base_toggled(true, 6)
	main._on_base_toggled(true, 12)
	main._check_puzzle()
	_check(main.overlay_kind == "success" and main.game["puzzle_solved"], "correct bases unlock evidence")
	_check(SaveData.load_game().get("puzzle_solved", false), "puzzle reward is saved")
	_check(main.xp_label.text == "50 XP", "evidence reward updates the HUD")
	main._clear_modal()
	main._interact()
	_check(main.overlay_kind == "success" and main.xp_label.text == "50 XP", "revisiting terminal does not duplicate rewards")
	_check(_has_label(main.modal_layer, "EVIDENCE ALREADY RECOVERED") and _has_label(main.modal_layer, "NO ADDITIONAL XP"), "repeat terminal visit clearly reports no duplicate reward")
	main._clear_modal()

	main.player_x = main.GATE_X
	main._interact()
	_check(main.overlay_kind == "complete" and main.game["chapter_complete"], "solved puzzle opens the gate and completes the prologue")
	_check(SaveData.load_game().get("chapter_complete", false), "chapter completion is saved")
	main._save_and_menu()
	_check(main.current_screen == "menu" and not main.saved_game.is_empty(), "return to title keeps the save")
	main._on_continue()
	_check(main.current_screen == "game" and main.overlay_kind == "" and main.game["puzzle_solved"], "continue resumes completed progress without replaying intro")

	main._enter_forest()
	_check(main.game["region"] == "forest" and main.overlay_kind == "forest_intro", "prologue leads into Sequence Forest")
	main.forest_region.dismiss_intro()
	_check(SaveData.load_game().get("forest_intro_seen", false), "forest intro dismissal is saved")
	main._enter_river()
	_check(main.game["region"] == "forest", "river stays locked before the forest is complete")
	main.player_x = main.forest_region.EXIT_X
	main._interact()
	_check(main.overlay_kind == "forest_blocked" and not main.game["forest_puzzle_solved"], "forest exit is blocked until the survey is solved")
	main._clear_modal()
	main.player_x = main.forest_region.SAGE_X
	main._interact()
	_check(main.overlay_kind == "sage", "Genome Sage dialogue opens")
	main.forest_region._open_gap_codex()
	_check(main.overlay_kind == "codex" and main.current_codex_page == 4, "sage links to the indel codex entry")
	main._return_to_previous()
	main.player_x = SaveData.FOREST_START_X
	main.forest_region._walk_to_archive()
	main._process(4.0)
	_check(main.overlay_kind == "forest_puzzle", "walking to the sprite opens the forest trial")
	var trial = main.forest_region.challenge
	trial._choose(0, 0)
	trial._choose(1, 2)
	trial._choose(2, 2)
	trial._check()
	_check(main.overlay_kind == "forest_puzzle" and not main.game["forest_puzzle_solved"], "incorrect classifications are rejected")
	_check(trial.row_status[1].text == "REVIEW", "incorrect observation is marked for review")
	trial._hint()
	_check(trial.feedback.text.contains("Gap in reference"), "forest hint describes gap orientation")
	trial._choose(1, 1)
	trial._check()
	_check(main.overlay_kind == "forest_success" and main.game["forest_puzzle_solved"], "correct classifications recover forest evidence")
	_check(main.xp_label.text == "150 XP" and GameProgress.collected_count(main.game) == 2, "both quest rewards are counted once")
	main._clear_modal()
	main._interact()
	_check(main.overlay_kind == "forest_success" and main.xp_label.text == "150 XP", "revisiting the forest trial does not duplicate rewards")
	_check(_has_label(main.modal_layer, "EVIDENCE ALREADY RECOVERED") and _has_label(main.modal_layer, "NO ADDITIONAL XP"), "repeat forest visit clearly reports no duplicate reward")
	main._clear_modal()
	main._open_journal_from_game()
	main.journal.show(1)
	_check(main.overlay_kind == "journal" and main.journal.current_page == 1, "journal opens the recovered forest evidence")
	main._return_to_previous()
	main.player_x = main.forest_region.EXIT_X
	main._interact()
	_check(main.overlay_kind == "forest_complete" and main.game["forest_complete"], "forest exit completes the chapter")
	_check(main.objective_title.text == "Forest chapter complete" and main.objective_detail.text.contains("arch"), "completed forest objective points to the river route")
	main._save_and_menu()
	main._on_continue()
	_check(main.game["region"] == "forest" and main.game["forest_complete"] and main.overlay_kind == "", "continue restores the forest checkpoint")
	_check(main.objective_title.text == "Forest chapter complete", "completed objective survives reload")

	main._enter_river()
	_check(main.game["region"] == "river" and main.overlay_kind == "river_intro", "forest completion leads to Alignment River")
	main.river_region.dismiss_intro()
	_check(SaveData.load_game().get("river_intro_seen", false), "river intro dismissal is saved")
	main._enter_swamp()
	_check(main.game["region"] == "river", "swamp stays locked until the river is complete")
	main.player_x = main.river_region.LANDING_X
	main._interact()
	_check(main.overlay_kind == "river_blocked" and not main.game["river_puzzle_solved"], "crossing is blocked before the boat is built")
	main._clear_modal()
	main.player_x = main.river_region.WISP_X
	main._interact()
	_check(main.overlay_kind == "river_wisp", "river wisp dialogue opens")
	main.river_region._open_overlap_codex()
	_check(main.overlay_kind == "codex" and main.current_codex_page == 5, "wisp links to the assembly codex entry")
	main._return_to_previous()
	main.player_x = SaveData.RIVER_START_X
	main.river_region._walk_to_ledger()
	main._process(4.0)
	_check(main.overlay_kind == "river_puzzle", "walking to the ledger opens the assembly trial")
	var assembly = main.river_region.challenge
	assembly._check()
	_check(not main.game["river_puzzle_solved"] and assembly.feedback.text.contains("Use all four"), "incomplete assembly is rejected")
	assembly._choose(1)
	assembly._choose(2)
	_check(assembly.order.size() == 1 and assembly.feedback.text.contains("fewer than"), "an insufficient overlap is rejected without losing the first read")
	assembly._hint()
	_check(assembly.feedback.text.contains("predecessor"), "assembly hint explains the starting read")
	assembly._choose(3)
	assembly._undo()
	_check(assembly.order.size() == 1, "undo removes the most recent read")
	assembly._choose(3)
	assembly._choose(0)
	assembly._choose(2)
	_check(assembly.TRIAL.assemble(assembly.order).get("contig") == "ATGCCGTTAGCTAAC", "ordered reads build the expected contig")
	assembly._check()
	_check(main.overlay_kind == "river_success" and main.game["river_puzzle_solved"], "correct assembly builds the boat and recovers evidence")
	_check(main.xp_label.text == "300 XP" and GameProgress.collected_count(main.game) == 3, "three evidence rewards are counted once")
	_check(main.river_region.boat_image.modulate.a == 1.0, "the restored boat becomes visible")
	_check(SaveData.load_game().get("river_puzzle_solved", false), "river puzzle progress is saved")
	main._clear_modal()
	main._interact()
	_check(main.overlay_kind == "river_success" and _has_label(main.modal_layer, "EVIDENCE ALREADY RECOVERED") and _has_label(main.modal_layer, "NO ADDITIONAL XP") and main.xp_label.text == "300 XP", "revisiting the ledger clearly reports no duplicate reward")
	main._clear_modal()
	main._open_journal_from_game()
	main.journal.show(2)
	_check(main.overlay_kind == "journal" and main.journal.current_page == 2 and _has_label(main.modal_layer, "ATGCCGTTAGCTAAC"), "journal contains the recovered river evidence")
	main._return_to_previous()
	main.player_x = main.river_region.LANDING_X
	main._interact()
	_check(main.overlay_kind == "river_complete" and main.game["river_complete"], "launching the boat completes the river with reduced motion")
	_check(main.objective_title.text == "River chapter complete" and main.objective_detail.text.contains("landing"), "completed river objective points to the swamp route")
	_check(_has_label(main.modal_layer, "Expression Swamp"), "river completion points to the playable swamp")
	# Exercise the animated crossing too, in addition to reduced-motion mode.
	main.game["river_complete"] = false
	main.settings["reduced_motion"] = false
	main._clear_modal()
	main._interact()
	_check(main.overlay_kind == "river_crossing" and main.game["river_complete"], "normal-motion crossing starts and saves completion")
	await create_timer(2.5).timeout
	_check(main.overlay_kind == "river_complete", "animated crossing reaches its completion screen")
	main.settings["reduced_motion"] = true # Keep the following Continue check synchronous.
	main._save_and_menu()
	main._on_continue()
	_check(main.game["region"] == "river" and main.game["river_complete"] and main.overlay_kind == "", "continue restores the river checkpoint")

	main._enter_swamp()
	_check(main.game["region"] == "swamp" and main.overlay_kind == "swamp_intro", "river completion leads to Expression Swamp")
	main.swamp_region.dismiss_intro()
	_check(SaveData.load_game().get("swamp_intro_seen", false), "swamp intro dismissal is saved")
	main._enter_missing()
	_check(main.game["region"] == "swamp", "missing-data dungeon stays locked until the swamp is complete")
	# The ambient Kraken bobs in normal motion and stays still in reduced motion.
	var still_y: float = main.swamp_region.kraken_image.position.y
	main.swamp_region.tick(0.5)
	_check(is_equal_approx(main.swamp_region.kraken_image.position.y, still_y), "reduced motion holds the Kraken still")
	main.settings["reduced_motion"] = false
	main.swamp_region.tick(0.5)
	var moving_y: float = main.swamp_region.kraken_image.position.y
	_check(not is_equal_approx(moving_y, still_y), "normal motion animates the Kraken")
	main.settings["reduced_motion"] = true
	main.swamp_region.tick(0.5)
	_check(is_equal_approx(main.swamp_region.kraken_image.position.y, moving_y), "enabling reduced motion stops ambient Kraken animation")
	main.player_x = main.swamp_region.ARCH_X
	main._interact()
	_check(main.overlay_kind == "swamp_blocked" and not main.game["swamp_puzzle_solved"], "marsh arch is blocked before the assay")
	main._clear_modal()
	main.player_x = main.swamp_region.KRAKEN_X
	main._interact()
	_check(main.overlay_kind == "swamp_kraken", "Kraken of Noise dialogue opens")
	main.swamp_region._open_expression_codex()
	_check(main.overlay_kind == "codex" and main.current_codex_page == 6, "Kraken links to the RNA-seq codex entry")
	main._return_to_previous()
	main.player_x = SaveData.SWAMP_START_X
	main.swamp_region._walk_to_assay()
	main._process(4.0)
	_check(main.overlay_kind == "swamp_puzzle", "walking to the assay opens the RNA-seq trial")
	var assay = main.swamp_region.challenge
	assay._check()
	_check(not main.game["swamp_puzzle_solved"] and assay.feedback.text.contains("exactly two"), "incomplete sample selection is rejected")
	assay._choose_sample(0)
	assay._choose_sample(2)
	assay._check()
	_check(assay.feedback.text.contains("failed"), "failed QC sample is rejected with feedback")
	assay._choose_sample(2)
	assay._choose_sample(3)
	assay._check()
	_check(assay.feedback.text.contains("batches"), "confounded batch pair is rejected")
	assay._choose_sample(3)
	assay._choose_sample(1)
	assay._check()
	_check(assay.feedback.text.contains("counts per million"), "a valid pair still requires a CPM answer")
	assay._choose_option(1)
	assay._check()
	_check(not main.game["swamp_puzzle_solved"] and assay.feedback.text.contains("divide"), "incorrect normalization is rejected")
	assay._hint()
	_check(assay.feedback.text.contains("mapped reads in millions"), "assay hint gives the CPM formula")
	assay._choose_option(0)
	assay._check()
	_check(main.overlay_kind == "swamp_success" and main.game["swamp_puzzle_solved"], "valid pair and CPM recover swamp evidence")
	_check(main.xp_label.text == "500 XP" and GameProgress.collected_count(main.game) == 4, "four evidence rewards are counted once")
	_check(SaveData.load_game().get("swamp_puzzle_solved", false), "swamp puzzle progress is saved")
	main._clear_modal()
	main._interact()
	_check(main.overlay_kind == "swamp_success" and _has_label(main.modal_layer, "NO ADDITIONAL XP") and main.xp_label.text == "500 XP", "revisiting the assay does not duplicate the reward")
	main._clear_modal()
	main._open_journal_from_game()
	main.journal.show(3)
	_check(main.overlay_kind == "journal" and main.journal.current_page == 3 and _has_label(main.modal_layer, "30 target counts per million"), "journal contains the marsh observation")
	_check(_has_label(main.modal_layer, "lacks replication"), "journal preserves assay limitations")
	main._return_to_previous()
	main.player_x = main.swamp_region.ARCH_X
	main._interact()
	_check(main.overlay_kind == "swamp_complete" and main.game["swamp_complete"], "crossing the arch completes the swamp")
	_check(main.objective_title.text == "Swamp chapter complete" and main.objective_detail.text.contains("arch"), "completed swamp objective points to the dungeon route")
	_check(_has_label(main.modal_layer, "Dungeon of Missing Data"), "swamp completion points to the playable dungeon")
	main._save_and_menu()
	main._on_continue()
	_check(main.game["region"] == "swamp" and main.game["swamp_complete"] and main.overlay_kind == "", "continue restores the swamp checkpoint")

	main._enter_missing()
	_check(main.game["region"] == "missing" and main.overlay_kind == "missing_intro", "swamp completion leads to the Dungeon of Missing Data")
	main.missing_region.dismiss_intro()
	_check(SaveData.load_game().get("missing_intro_seen", false), "missing-data intro dismissal is saved")
	var dragon_still: float = main.missing_region.dragon_image.position.y
	main.missing_region.tick(0.5)
	_check(is_equal_approx(main.missing_region.dragon_image.position.y, dragon_still), "reduced motion holds the dragon still")
	main.settings["reduced_motion"] = false
	main.missing_region.tick(0.5)
	var dragon_moving: float = main.missing_region.dragon_image.position.y
	_check(not is_equal_approx(dragon_moving, dragon_still), "normal motion animates the dragon")
	main.settings["reduced_motion"] = true
	main.missing_region.tick(0.5)
	_check(is_equal_approx(main.missing_region.dragon_image.position.y, dragon_moving), "enabling reduced motion stops dragon animation")
	main.player_x = main.missing_region.DOOR_X
	main._interact()
	_check(main.overlay_kind == "missing_blocked" and not main.game["missing_puzzle_solved"], "archive door is blocked before the ledger")
	main._clear_modal()
	main.player_x = main.missing_region.DRAGON_X
	main._interact()
	_check(main.overlay_kind == "missing_dragon", "Draco Variantus dialogue opens")
	main.missing_region._open_pileup_codex()
	_check(main.overlay_kind == "codex" and main.current_codex_page == 7, "dragon links to the variant-evidence codex entry")
	main._return_to_previous()
	main.player_x = SaveData.MISSING_START_X
	main.missing_region._walk_to_ledger()
	main._process(4.0)
	_check(main.overlay_kind == "missing_puzzle", "walking to the ledger opens the pileup trial")
	var pileup = main.missing_region.challenge
	pileup._check()
	_check(not main.game["missing_puzzle_solved"] and pileup.feedback.text.contains("every site"), "incomplete classifications are rejected")
	pileup._choose(0, 0)
	pileup._choose(1, 0)
	pileup._choose(2, 2)
	pileup._check()
	_check(pileup.feedback.text.contains("127") and not main.game["missing_puzzle_solved"], "low-quality alternate is rejected")
	pileup._choose(1, 1)
	pileup._choose(2, 1)
	pileup._check()
	_check(pileup.feedback.text.contains("Low coverage"), "missing coverage is not treated as reference")
	pileup._choose(2, 2)
	pileup._check()
	_check(pileup.feedback.text.contains("alternate base"), "a valid set still requires alternate support")
	pileup._choose_support(1)
	pileup._check()
	_check(pileup.feedback.text.contains("passing reads only"), "raw rather than quality-filtered support is rejected")
	pileup._hint()
	_check(pileup.feedback.text.contains("below 30"), "pileup hint explains the quality threshold")
	pileup._choose_support(0)
	pileup._check()
	_check(main.overlay_kind == "missing_success" and main.game["missing_puzzle_solved"], "correct classifications and support recover the ledger")
	_check(main.xp_label.text == "750 XP" and GameProgress.collected_count(main.game) == 5, "all five evidence rewards are counted once")
	_check(SaveData.load_game().get("missing_puzzle_solved", false), "ledger progress is saved")
	main._clear_modal()
	main._interact()
	_check(main.overlay_kind == "missing_success" and _has_label(main.modal_layer, "NO ADDITIONAL XP") and main.xp_label.text == "750 XP", "revisiting the ledger does not duplicate the reward")
	main._clear_modal()
	main._open_journal_from_game()
	main.journal.show(4)
	_check(main.overlay_kind == "journal" and main.journal.current_page == 4 and _has_label(main.modal_layer, "two of four passing reads"), "journal contains the dragon ledger observation")
	_check(_has_label(main.modal_layer, "independently"), "journal retains ledger limitations")
	main._return_to_previous()
	main.player_x = main.missing_region.DOOR_X
	main._interact()
	_check(main.overlay_kind == "missing_complete" and main.game["missing_complete"], "archive door completes the missing-data dungeon")
	_check(main.objective_title.text == "Dungeon chapter complete", "completed dungeon objective updates")
	_check(_has_label(main.modal_layer, "The Final Trial") and _has_label(main.modal_layer, "Hall of Records"), "dungeon completion points to the playable final trial")
	main._save_and_menu()
	main._on_continue()
	_check(main.game["region"] == "missing" and main.game["missing_complete"] and main.overlay_kind == "", "continue restores the missing-data dungeon checkpoint")

	main._enter_final()
	_check(main.game["region"] == "final" and main.overlay_kind == "final_intro", "completed dungeon leads to the final trial")
	main.final_region.dismiss_intro()
	_check(SaveData.load_game().get("final_intro_seen", false), "final-trial intro dismissal is saved")
	main.player_x = main.final_region.COUNCIL_X
	main._interact()
	_check(main.overlay_kind == "final_blocked" and not main.game["final_case_prepared"], "council waits until the case is prepared")
	main._clear_modal()
	main.player_x = main.final_region.LYRA_X
	main._interact()
	_check(main.overlay_kind == "final_lyra", "Princess Lyra dialogue opens")
	main.final_region._open_custody_codex()
	_check(main.overlay_kind == "codex" and main.current_codex_page == 8, "Lyra links to chain-of-custody codex")
	main._return_to_previous()
	main.player_x = SaveData.FINAL_START_X
	main.final_region._walk_to_desk()
	main._process(4.0)
	_check(main.overlay_kind == "final_review", "walking to the table opens the evidence review")
	var final_case = main.final_region.challenge
	final_case._check_claims()
	_check(final_case.feedback.text.contains("Select the statements"), "empty evidence review is rejected")
	final_case._toggle_claim(1)
	final_case._check_claims()
	_check(final_case.feedback.text.contains("more than") and not main.game["final_case_prepared"], "unsupported evidence is rejected")
	final_case._toggle_claim(1)
	final_case._toggle_claim(0)
	final_case._open_journal("final_review")
	main.journal.show(1)
	_check(main.overlay_kind == "journal" and _has_label(main.modal_layer, "teaching alignments"), "case can consult the source and limitations")
	main._return_to_previous()
	_check(main.overlay_kind == "final_review" and final_case.selected_claims == [0], "returning from the journal keeps review selections")
	final_case._toggle_claim(2)
	final_case._toggle_claim(4)
	final_case._toggle_claim(5)
	final_case._check_claims()
	_check(main.overlay_kind == "final_profile", "defensible evidence opens the profile comparison")
	final_case._present()
	_check(final_case.feedback.text.contains("each row"), "incomplete case is rejected")
	final_case._choose_answer(0, 1)
	final_case._choose_answer(1, 1)
	final_case._choose_answer(2, 2)
	final_case._open_journal("final_profile")
	_check(main.overlay_kind == "journal", "profile comparison can open the journal")
	main._return_to_previous()
	_check(main.overlay_kind == "final_profile" and final_case.answers == [1, 1, 2], "returning from the journal keeps profile selections")
	final_case._present()
	_check(main.overlay_kind == "final_dismissed" and not main.game["final_case_prepared"], "identity overclaim is dismissed without a reward")
	_check(_has_label(main.modal_layer, "does not identify"), "dismissal explains why short profiles cannot identify a twin")
	final_case.show_profile()
	_check(final_case.answers == [1, 1, 2], "dismissed case retains selections for revision")
	final_case._choose_answer(1, 0)
	final_case._present()
	_check(main.overlay_kind == "final_ready" and main.game["final_case_prepared"], "defensible case is prepared")
	_check(main.xp_label.text == "1050 XP" and GameProgress.collected_count(main.game) == 6, "six evidence rewards are counted once")
	_check(SaveData.load_game().get("final_case_prepared", false), "case preparation is saved")
	main._clear_modal()
	main._interact()
	_check(main.overlay_kind == "final_ready" and _has_label(main.modal_layer, "NO ADDITIONAL XP") and main.xp_label.text == "1050 XP", "revisiting the case cannot duplicate rewards")
	main._clear_modal()
	main._open_journal_from_game()
	main.journal.show(5)
	_check(main.overlay_kind == "journal" and _has_label(main.modal_layer, "public summary says none"), "journal records the report conflict")
	_check(_has_label(main.modal_layer, "same aliquot") and _has_label(main.modal_layer, "cannot identify"), "journal keeps the repeat's source and identity limitations")
	main._return_to_previous()
	main.player_x = main.final_region.COUNCIL_X
	main._interact()
	_check(main.overlay_kind == "final_hearing" and not main.game["final_complete"], "prepared case opens the public hearing")
	main.final_region.show_review()
	_check(main.overlay_kind == "final_hearing_review" and _has_label(main.modal_layer, "admission"), "separate corroboration and confession are presented")
	main.final_region._finish_trial()
	_check(main.overlay_kind == "final_complete" and main.game["final_complete"] and _has_label(main.modal_layer, "public inquiry"), "the nonviolent story ending completes")
	_check(SaveData.load_game().get("final_complete", false), "final completion is saved")
	main._save_and_menu()
	main._on_continue()
	_check(main.game["region"] == "final" and main.game["final_complete"] and main.overlay_kind == "", "continue restores the completed final trial")
	main._interact()
	_check(main.overlay_kind == "final_complete" and main.xp_label.text == "1050 XP", "the ending can be revisited without duplicate XP")
	main._clear_modal()

	main._show_pause()
	main._open_journal_from_pause()
	_check(main.overlay_kind == "journal", "journal opens from pause")
	main._return_to_previous()
	_check(main.overlay_kind == "pause", "journal returns to pause menu")
	main._open_codex_from_pause()
	main._show_codex(3)
	_check(main.overlay_kind == "codex" and main.current_codex_page == 3, "codex navigation works")
	main._return_to_previous()
	_check(main.overlay_kind == "pause", "codex returns to pause menu")
	main._open_settings_from_pause()
	main._toggle_hints()
	_check(not main.settings["show_hints"] and not main.controls_tip.visible, "movement hint setting affects the HUD")
	main._return_to_previous()
	_check(main.overlay_kind == "pause", "settings returns to pause menu")

	var corrupt := FileAccess.open(SaveData.GAME_PATH, FileAccess.WRITE)
	corrupt.store_string("not valid json")
	corrupt.close()
	_check(SaveData.load_game().is_empty(), "a corrupt save does not crash Continue")
	var corrupt_bytes := FileAccess.get_file_as_bytes(SaveData.GAME_PATH)
	main._show_menu()
	_check(main.saved_game.is_empty() and _has_label(main.scene_layer, "SAVE UNREADABLE"), "title warns about an unreadable save")
	main._on_new_game()
	_check(main.overlay_kind == "confirm" and _has_label(main.modal_layer, "cannot be read"), "new game requires confirmation before replacing an unreadable save")
	main._clear_modal()
	_check(FileAccess.get_file_as_bytes(SaveData.GAME_PATH) == corrupt_bytes, "cancel preserves the unreadable save bytes")
	var malformed := FileAccess.open(SaveData.GAME_PATH, FileAccess.WRITE)
	malformed.store_string('{"version": [], "puzzle_solved": true, "chapter_complete": false}')
	malformed.close()
	_check(SaveData.load_game().is_empty(), "a malformed save version is rejected")
	_restore_file(SaveData.GAME_PATH, old_game)
	_restore_file(SaveData.SETTINGS_PATH, old_settings)
	main.queue_free()
	if failures.is_empty():
		print("PASS: six-location flow, six case rewards, hearing, journal, continue, motion settings and corrupt-save warning")
		quit(0)
	else:
		print("FAILURES: ", failures.size())
		quit(1)
